{
  "name": "@nakednous/idiom",
  "version": "0.0.1",
  "description": "idiom — the bridges' shared composite layer: targets, passes, pipe, state. Internal, zero renderer.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test test/",
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "reset": "rm -rf node_modules dist package-lock.json && npm install",
    "link:core": "npm link @nakednous/tree",
    "unlink:core": "npm unlink --no-save @nakednous/tree && npm install @nakednous/tree",
    "prepublishOnly": "npm run rebuild",
    "postpublish": "npm run link:core"
  },
  "keywords": [
    "webgl",
    "webgpu",
    "render-target",
    "pass",
    "internal"
  ],
  "author": "Jean Pierre Charalambos <nakednous@gmail.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakednous/idiom.git"
  },
  "dependencies": {
    "@nakednous/tree": "^0.0.34"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.64.8"
  }
}
